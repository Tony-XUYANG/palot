DATABASE_URL=postgresql://palot:change-me@postgres:5432/palot
# Alternatively provide PALOT_POSTGRES_HOST, PALOT_POSTGRES_PORT,
# PALOT_POSTGRES_USERNAME, PALOT_POSTGRES_PASSWORD, and PALOT_POSTGRES_DATABASE.
PALOT_TOKEN_PEPPER=replace-with-at-least-32-random-characters
PALOT_MARKUP_BASIS_POINTS=3000
PALOT_UPSTREAM_TIMEOUT_MS=300000
PALOT_RESERVATION_TTL_MS=900000
PALOT_PAYMENT_MODE=disabled
PALOT_PUBLIC_URL=https://cloud.palot.example
# Required only when PALOT_PAYMENT_MODE=alipay.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
PORT=8080
